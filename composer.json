{
    "name": "jamesonrgrieve/wp-woo-bundles",
    "description": "Product bundles for WooCommerce: fixed and optional items sold together.",
    "type": "wordpress-plugin",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Jameson Grieve"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "php-stubs/woocommerce-stubs": "^10.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WooBundles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooBundles\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-install-cmd": "git config core.hooksPath .githooks",
        "post-update-cmd": "git config core.hooksPath .githooks",
        "lint": "find src tests wp-woo-bundles.php -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "format": "php-cs-fixer fix",
        "format-check": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit --testsuite unit",
        "check": [
            "@lint",
            "@format-check",
            "@analyse",
            "@test",
            "@composer audit",
            "@composer validate --strict"
        ]
    }
}
